{
  "name": "pi-interactive-subagents",
  "version": "3.7.2",
  "description": "Interactive subagents for pi - spawn, orchestrate, and manage sub-agent sessions in tmux and Herdr",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Amos Blomqvist",
  "repository": {
    "type": "git",
    "url": "https://github.com/gpmarques/pi-interactive-subagents"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "test:integration:surface": "node --test --test-concurrency=1 test/integration/mux-surface.test.ts",
    "test:integration:web-tools": "node --test --test-concurrency=1 test/integration/web-tools-offline.test.ts",
    "test:web-preflight-hermetic": "node --test test/web-capability-preflight-hermetic.test.ts",
    "test:integration:lifecycle-smoke": "node --test --test-concurrency=1 test/integration/mux-lifecycle-smoke.test.ts",
    "test:integration:lifecycle": "node --test --test-concurrency=1 test/integration/subagent-lifecycle.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./pi-extension/subagents/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "typebox": "^1.3.7"
  }
}
